{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "编译并运行当前文件",
      "detail": "对当前打开的 .c 文件：编译 → 运行（Ctrl+Shift+B）",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\run-all.ps1",
        "${fileBasenameNoExtension}"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "编译并运行全部",
      "detail": "把本目录 13 个 .c 文件全部编译并运行一遍",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\run-all.ps1"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "调试编译（带调试信息）",
      "detail": "只编译当前文件，产出 build\\<文件名>_debug.exe，供 F5 调试（不运行）",
      "type": "shell",
      "command": "cmd",
      "args": [
        "/c",
        "${workspaceFolder}\\debug-build.cmd",
        "${fileBasename}"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "silent", "panel": "shared", "clear": true }
    }
  ]
}